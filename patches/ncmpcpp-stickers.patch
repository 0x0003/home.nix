+std::string Song::getRating(unsigned idx) const
+{
+	if (idx > 0)
+		return "";
+	const char *uri = c_uri();
+	if (!uri || !*uri)
+		return "";
+	std::string val = getCachedSticker(uri, "rating");
+	if (val.empty())
+		return "";
+	int r = 0;
+	try {
+		r = boost::lexical_cast<int>(val);
+	} catch (...) {
+		return "";
+	}
+	if (r <= 0)
+		return "";
+	r = std::min(r, 10);
+	static const std::string kFull = "\xe2\x98\x85";  // U+2605 black star
+	static const std::string kHalf = "\xe2\xaf\xaa";  // U+2BEA star with left half black
+	static const std::string kEmpty = "\xe2\x98\x86"; // U+2606 white star
+	int full = r / 2;
+	int half = r % 2;
+	std::string result;
+	for (int i = 0; i < full; ++i)
+		result += kFull;
+	if (half)
+		result += kHalf;
+	for (int i = full + half; i < 5; ++i)
+		result += kEmpty;
+	return result;
+}
+
+std::string Song::getPlayCount(unsigned idx) const
+{
+	if (idx > 0)
+		return "";
+	const char *uri = c_uri();
+	if (!uri || !*uri)
+		return "";
+	std::string val = getCachedSticker(uri, "playCount");
+	if (val.empty())
+		return "";
+	return val;
+}
+
+std::string Song::getLastPlayed(unsigned idx) const
+{
+	if (idx > 0)
+		return "";
+	const char *uri = c_uri();
+	if (!uri || !*uri)
+		return "";
+	return formatTimestamp(getCachedSticker(uri, "lastPlayed"));
+}
+
+std::string Song::getFirstPlayed(unsigned idx) const
+{
+	if (idx > 0)
+		return "";
+	const char *uri = c_uri();
+	if (!uri || !*uri)
+		return "";
+	return formatTimestamp(getCachedSticker(uri, "firstPlayed"));
+}
