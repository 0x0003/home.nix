+std::unordered_map<std::string, std::string> &stickerCache()
+{
+	static std::unordered_map<std::string, std::string> cache;
+	return cache;
+}
+
+std::string getCachedSticker(const char *uri, const std::string &name)
+{
+	if (!uri || !*uri)
+		return "";
+	std::string key = name + "\n" + uri;
+	auto &cache = stickerCache();
+	auto it = cache.find(key);
+	if (it != cache.end())
+		return it->second;
+	std::string value;
+	try {
+		value = Mpd.GetSticker(uri, name);
+	} catch (...) {
+		value = "";
+	}
+	cache[key] = value;
+	return value;
+}
+
+} // anonymous namespace
