+// Convert a Unix timestamp (seconds or milliseconds) to a human readable
+// string according to Config.sticker_timestamp_format.
+	std::string formatTimestamp(const std::string &val)
+	{
+		long long t = 0;
+		try {
+			t = boost::lexical_cast<long long>(val);
+		} catch (...) {
+			return "";
+		}
+		if (t <= 0)
+			return "";
+	if (t > 100000000000LL)
+		t /= 1000;
+		time_t tt = static_cast<time_t>(t);
+		tm tinfo;
+		localtime_r(&tt, &tinfo);
+		char buf[64];
+		if (strftime(buf, sizeof(buf), Config.sticker_timestamp_format.c_str(), &tinfo) == 0)
+			return "";
+		return buf;
+	}
